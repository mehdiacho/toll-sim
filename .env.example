# Copy to .env and replace every value. .env is git-ignored.
POSTGRES_PASSWORD=change-me
ADMIN_API_KEY=change-me-admin
INGEST_API_KEY=change-me-ingest
MOMO_WEBHOOK_SECRET=change-me-webhook
# Optional
# API_PORT=3000
# MOMO_PORT=4000
# MOMO_CALLBACK_DELAY_MS=1500
# VIOLATION_GRACE_DAYS=7
# REVIEW_CONFIDENCE_THRESHOLD=0.96
# Enforcement: admin fee at the first notice, late fee at the final notice (thebe),
# days from the end of grace to the final notice, then to referral.
# ENFORCEMENT_ADMIN_FEE_THEBE=5000
# ENFORCEMENT_LATE_FEE_THEBE=15000
# ENFORCEMENT_FINAL_NOTICE_DAYS=14
# ENFORCEMENT_REFERRAL_DAYS=14
# ENFORCEMENT_INTERVAL_MINUTES=60   # 0 = only via POST /admin/run-enforcement
# DISPUTE_WINDOW_DAYS=90
# CUSTOMER_SESSION_DAYS=30
# EXPOSE_LOGIN_CODES=0              # 1 returns sign-in codes in the API response (demo only, never in production)
