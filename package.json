{
  "name": "toll-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Open-road tolling back office for a simulated Botswana A1 toll road",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "start:momo": "node dist/src/momo/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:momo": "tsx watch src/momo/server.ts",
    "dev:lite": "node --import tsx scripts/dev-lite.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
